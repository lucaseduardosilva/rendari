generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ USUÁRIO E AUTENTICAÇÃO ============

enum UserType {
  PF
  PJ
}

enum Role {
  USER
  ADMIN
}

enum TokenType {
  EMAIL_VERIFY
  PHONE_VERIFY
  PASSWORD_RESET
}

enum TaxRegime {
  SIMPLES
  LUCRO_PRESUMIDO
  LUCRO_REAL
  MEI
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  emailVerified   Boolean    @default(false)
  emailVerifiedAt DateTime?
  passwordHash    String
  phone           String?
  phoneVerified   Boolean    @default(false)
  phoneVerifiedAt DateTime?
  name            String
  type            UserType   @default(PF)
  documentNumber  String     @unique // CPF (PF) ou CNPJ (PJ)
  role            Role       @default(USER)
  active          Boolean    @default(true)
  planId          String?
  whitelabel      Json?      // { brandName, logoUrl, faviconUrl, paletteDark, paletteLight }
  preferences     Json?      // { theme, locale, sidebarHidden }
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  plan            Plan?              @relation(fields: [planId], references: [id])
  company         Company?
  sessions        Session[]
  tokens          VerificationToken[]
  incomes         Income[]
  expenses        Expense[]
  expensePayments ExpensePayment[]
  assets          Asset[]
  debts           Debt[]
  goals           Goal[]
  allocations     AllocationPlan[]
  vehicles        Vehicle[]
  vehicleExpenses VehicleExpense[]
  properties      Property[]
  propertyEntries PropertyEntry[]
  streams         Stream[]
  streamEntries   StreamEntry[]
  savedSims       SavedSimulation[]
  customOptions   CustomOption[]

  @@index([documentNumber])
  @@index([planId])
}

model Plan {
  id           String   @id @default(cuid())
  slug         String   @unique // free, pro, business, enterprise
  name         String
  description  String?
  priceMonth   Decimal  @default(0)
  priceYear    Decimal  @default(0)
  features     Json     // { whitelabel, maxUsers, support, ... }
  visibleFor   String   @default("ALL") // PF, PJ, ALL
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  users        User[]
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  type      TokenType
  token     String    @unique
  channel   String?   // email, sms, whatsapp
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// ============ EMPRESA (PJ) ============

model Company {
  id              String     @id @default(cuid())
  userId          String     @unique
  legalName       String     // Razão Social
  tradeName       String?    // Nome Fantasia
  cnpj            String     @unique
  taxRegime       TaxRegime  @default(SIMPLES)
  stateReg        String?    // Inscrição Estadual
  municipalReg    String?    // Inscrição Municipal
  address         String?
  city            String?
  state           String?
  zipCode         String?
  foundedAt       DateTime?
  phone           String?
  website         String?
  logo            String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  employees       Employee[]
  payrolls        Payroll[]
  invoices        Invoice[]
  costCenters     CostCenter[]
  departments     Department[]
}

model Employee {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  cpf          String?
  role         String   // cargo
  departmentId String?
  salary       Decimal
  benefits     Decimal  @default(0)
  admissionAt  DateTime
  dismissedAt  DateTime?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department   Department? @relation(fields: [departmentId], references: [id])
  payrolls     Payroll[]
}

model Payroll {
  id           String   @id @default(cuid())
  companyId    String
  employeeId   String?
  refMonth     String   // YYYY-MM
  grossSalary  Decimal
  inss         Decimal  @default(0)
  fgts         Decimal  @default(0)
  irrf         Decimal  @default(0)
  benefits     Decimal  @default(0)
  deductions   Decimal  @default(0)
  netSalary    Decimal
  paid         Boolean  @default(false)
  paidAt       DateTime?
  createdAt    DateTime @default(now())
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee     Employee? @relation(fields: [employeeId], references: [id])

  @@index([companyId, refMonth])
}

model Invoice {
  id           String   @id @default(cuid())
  companyId    String
  number       String
  type         String   // entrada (compra) | saida (venda)
  partyName    String   // cliente ou fornecedor
  partyDoc     String?  // CPF/CNPJ
  description  String?
  value        Decimal
  taxes        Decimal  @default(0)
  issuedAt     DateTime
  status       String   @default("emitida")
  createdAt    DateTime @default(now())
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, type])
}

model CostCenter {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  code        String?
  budget      Decimal? @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Department {
  id          String     @id @default(cuid())
  companyId   String
  name        String
  manager     String?
  createdAt   DateTime   @default(now())
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees   Employee[]
}

// ============ FINANÇAS PESSOAIS / CORPORATIVAS ============

model Income {
  id        String   @id @default(cuid())
  userId    String
  desc      String
  cat       String
  freq      String   // monthly, annual, one-time
  value     Decimal
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Expense {
  id            String   @id @default(cuid())
  userId        String
  desc          String
  cat           String
  type          String   // essencial, desejo, investimento
  freq          String   // monthly, annual, one-time, installments
  value         Decimal
  day           Int?
  startMonth    String?  // YYYY-MM
  installments  Int?     // se freq=installments
  costCenterId  String?  // PJ
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments      ExpensePayment[]

  @@index([userId])
}

model ExpensePayment {
  id         String   @id @default(cuid())
  userId     String
  expenseId  String
  refMonth   String   // YYYY-MM
  paidAt     DateTime @default(now())
  amount     Decimal?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expense    Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@unique([expenseId, refMonth])
}

model Asset {
  id        String   @id @default(cuid())
  userId    String
  name      String
  cat       String
  value     Decimal
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Debt {
  id        String   @id @default(cuid())
  userId    String
  name      String
  cat       String
  value     Decimal
  rate      Decimal  @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Goal {
  id        String   @id @default(cuid())
  userId    String
  name      String
  icon      String   @default("🎯")
  target    Decimal
  current   Decimal  @default(0)
  months    Int      @default(12)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AllocationPlan {
  id        String   @id @default(cuid())
  userId    String
  savedId   String   // referência a SavedSimulation
  mode      String   // fixed, pct, salary
  value     Decimal
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Vehicle {
  id           String   @id @default(cuid())
  userId       String
  brand        String
  model        String
  type         String?
  year         Int?
  plate        String?
  color        String?
  buy          Decimal  @default(0)
  current      Decimal  @default(0)
  km           Int      @default(0)
  fuel         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses     VehicleExpense[]

  @@index([userId])
}

model VehicleExpense {
  id        String   @id @default(cuid())
  userId    String
  vehicleId String
  date      DateTime
  cat       String
  desc      String?
  value     Decimal
  km        Int?
  liters    Decimal?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

model Property {
  id           String   @id @default(cuid())
  userId       String
  name         String
  type         String
  purpose      String   // residence, rental, sale, vacation, commercial
  addr         String?
  area         Decimal? @default(0)
  rooms        Int?     @default(0)
  buy          Decimal  @default(0)
  current      Decimal  @default(0)
  debt         Decimal  @default(0)
  rent         Decimal  @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries      PropertyEntry[]

  @@index([userId])
}

model PropertyEntry {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  date       DateTime
  type       String   // expense, income
  cat        String
  desc       String?
  value      Decimal
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model Stream {
  id           String   @id @default(cuid())
  userId       String
  name         String
  type         String
  status       String   @default("active") // active, paused, planned, closed
  desc         String?
  invest       Decimal  @default(0)
  ticket       Decimal  @default(0)
  cost         Decimal  @default(0)
  freq         Int      @default(1)
  lifetime     Int      @default(12)
  fixed        Decimal  @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries      StreamEntry[]

  @@index([userId])
}

model StreamEntry {
  id       String   @id @default(cuid())
  userId   String
  streamId String
  date     DateTime
  type     String   // revenue, cost, opex, cac, capex
  cat      String?
  desc     String?
  qty      Int      @default(1)
  value    Decimal
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stream   Stream   @relation(fields: [streamId], references: [id], onDelete: Cascade)

  @@index([streamId])
}

model SavedSimulation {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      String   // simple | hybrid
  data      Json     // payload completo da simulação
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============ AUDITORIA ============

model CustomOption {
  id        String   @id @default(cuid())
  userId    String
  scope     String   // ex: expense.cat, income.cat, asset.cat, vehicle.type
  value     String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, value])
  @@index([userId, scope])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
}
